# Cabeçalhos de segurança aplicados pelo Cloudflare Pages a todas as respostas.
# Espelha o que era o headers() do next.config.ts (removido ao migrar para
# output: "export"). Mantenha em sincronia com next.config.ts / a política.
#
# CSP: 'unsafe-inline' em script é necessário para o script anti-flash de tema
# (inline, sem nonce) e para o bootstrap de hidratação do Next em páginas
# estáticas. connect-src/form-action = 'self': o site não fala com terceiros
# (waitlist/Formspree saíram). Os botões que levam ao app são navegação de
# topo (não cobertos por form-action).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# As imagens sociais são geradas pelo Next como arquivos sem extensão
# (out/opengraph-image, out/twitter-image). Sem isto o Pages serviria com o
# Content-Type errado e os scrapers de OG/Twitter não reconheceriam a imagem.
/opengraph-image
  Content-Type: image/png

/twitter-image
  Content-Type: image/png
