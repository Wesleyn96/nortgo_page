# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# documento de acompanhamento — anexo local com informação sensível
# (a parte pública fica versionada em docs/PROJETO.md)
PROJETO.local.md

# fonte pesada do vídeo do hero — só o resultado otimizado é versionado
# (ver scripts/optimize-demo-video.sh)
public/nortgo-demo-original.mp4

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ignorar docs de referência locais (planos, briefings) — não versionar
docs/referencia/
